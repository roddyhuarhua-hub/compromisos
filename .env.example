# Copia este archivo como .env y pega UNA de las dos claves.
# Opción 1: Groq (https://console.groq.com/keys) -> Whisper large v3 turbo + Llama 3.3
GROQ_API_KEY=
# Opción 2: Gemini (https://aistudio.google.com/apikey) -> Whisper local + Gemini Flash
GEMINI_API_KEY=
# Opcional: cambiar modelos
# MODELO_WHISPER=whisper-large-v3-turbo
# MODELO_LLM=llama-3.3-70b-versatile
# MODELO_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# MODELO_GEMINI=gemini-2.5-flash   (vacío = la app elige el mejor Flash disponible)
# MODELO_WHISPER_LOCAL=base
